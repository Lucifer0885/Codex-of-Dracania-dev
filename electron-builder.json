{
    "appId": "com.lucifer0885.codex-of-dracania",
    "artifactName": "Setup-${version}.${ext}",
    "extraResources": ["dist-electron/preload.cjs", "src/assets/**"],
    "electronLanguages": [
        "en"
    ],
    "productName": "Codex of Dracania",
    "files": [
        "dist-react/**/*",
        "dist-electron/**/*",
        "!node_modules"
    ],
    "directories": {
        "output": "dist"
    },
    "win": {
        "icon": "src/assets/dracania-codex.png",
        "target": [
            {
                "target": "nsis",
                "arch": [
                    "x64"
                ]
            }
        ]
    }
}