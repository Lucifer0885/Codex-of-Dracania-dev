{
    "appId": "com.lucifer0885.codex-of-dracania",
    "artifactName": "Setup-${version}.${ext}",
    "extraResources": [
        "dist-electron/preload.cjs",
        "src/assets/**",
        "src/react/assets/**"
    ],
    "productName": "Codex of Dracania",
    "files": [
        "dist-react/**/*",
        "dist-electron/**/*"
    ],
    "directories": {
        "output": "dist"
    },
    "win": {
        "icon": "src/assets/dracania-codex.png",
        "target": [
            {
                "target": "nsis",
                "arch": [
                    "x64"
                ]
            }
        ]
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "license": "installer-license.md",
        "uninstallDisplayName": "Uninstall Codex of Dracania",
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "runAfterFinish": true
    }
}