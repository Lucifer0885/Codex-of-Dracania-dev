{
    "appId": "com.lucifer0885.dso-utils",
    "artifactName": "Dso Utils-${version}.${ext}",
    "extraResources": ["dist-electron/preload.cjs"],
    "electronLanguages": [
        "en"
    ],
    "executableName" : "DsoUtils",
    "files": [
        "dist-react/**/*",
        "dist-electron/**/*"
    ],
    "asarUnpack": [
        "**/node_modules/@emnapi/**/*",
        "**/node_modules/tailwindcss/**/*.wasm"
    ],
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "win": {
        "icon": "assets/dso.ico",
        "target": [
            {
                "target": "portable",
                "arch": [
                    "x64"
                ]
            }
        ]
    }
}